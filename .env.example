FLASK_APP=app.py
FLASK_DEBUG=False

# 'demo' para simulación académica con datos históricos, 'production' para planta real
APP_MODE=demo

# Clave secreta criptográfica para sesiones y tokens CSRF
SECRET_KEY=cambiar-por-una-cadena-aleatoria-segura-en-produccion
